{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/eldenizfamilyanskicode/agent-workstation-gateway/protocol/schemas/v1/request.schema.json",
  "title": "Agent Workstation Gateway protocol v1 request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "request_id",
    "session_id",
    "actor",
    "shell",
    "working_directory",
    "script",
    "timeout_seconds",
    "max_output_bytes",
    "artifacts"
  ],
  "properties": {
    "protocol_version": {
      "type": "integer",
      "const": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "shell": {
      "type": "string",
      "enum": ["bash", "cmd", "git-bash", "powershell", "pwsh"]
    },
    "working_directory": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "x-awg-max-utf8-bytes": 1024,
      "anyOf": [
        {"pattern": "^/"},
        {"pattern": "^[A-Za-z]:\\\\"}
      ]
    },
    "script": {
      "type": "string",
      "minLength": 1,
      "maxLength": 49152,
      "x-awg-max-utf8-bytes": 49152
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400
    },
    "max_output_bytes": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 5242880
    },
    "artifacts": {
      "type": "array",
      "maxItems": 8,
      "items": {"$ref": "#/$defs/artifact_selection"}
    }
  },
  "$defs": {
    "artifact_selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "paths"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-z0-9][a-z0-9._-]{0,31}$"
        },
        "paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "x-awg-max-utf8-bytes": 256,
            "pattern": "^[^/\\\\:]"
          }
        }
      }
    }
  }
}
