{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/eldenizfamilyanskicode/agent-workstation-gateway/runtime/schemas/v1/execute-envelope.schema.json",
  "title": "Agent Workstation Gateway local broker execute envelope v1",
  "type": "object",
  "x-awg-max-encoded-bytes": 147456,
  "additionalProperties": false,
  "required": ["protocol_version", "operation", "attempt_id", "accepted_request"],
  "properties": {
    "protocol_version": {
      "type": "integer",
      "const": 1
    },
    "operation": {
      "type": "string",
      "const": "execute"
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "accepted_request": {
      "$ref": "../../../protocol/schemas/v1/accepted-request.schema.json"
    }
  }
}
